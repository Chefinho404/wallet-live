# Copie este arquivo para .env (cp .env.example .env) e troque os segredos.
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet

# Assina o JWT. Use pelo menos 32 caracteres. Ex.: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-do-jwt-por-outro-valor-aleatorio

# Assina o cookie. Precisa ter pelo menos 64 caracteres. Ex.: openssl rand -base64 64
COOKIE_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio-com-mais-de-64-caracteres

BIND_ADDR=127.0.0.1:3000
